---
layout: "layouts/base.njk"
---
<div class="page-container page-content-wrapper">
    <header class="page-header">
        <h1 class="page-title">{{ title }}</h1>
        {% if description %}
            <p class="page-intro">{{ description }}</p>
        {% endif %}
    </header>

    <div class="page-body">
        {{ content | safe }}
    </div>
</div>
