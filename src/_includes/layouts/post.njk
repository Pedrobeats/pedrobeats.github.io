---
layout: "layouts/base.njk"
---
<article class="article-container">
    <nav class="article-breadcrumb" aria-label="Navegação de retorno">
        {% if "/portfolio" in page.url %}
            <a href="/portfolio/" class="breadcrumb-link">← Voltar para o Portfólio</a>
        {% else %}
            <a href="/blog/" class="breadcrumb-link">← Voltar para o Blog</a>
        {% endif %}
    </nav>

    {% if thumbnail %}
    <div class="article-hero-image">
        <img src="{{ thumbnail }}" alt="Imagem de cabeçalho para {{ title }}">
    </div>
    {% endif %}

    <header class="article-header">
        {% if tags %}
            <div class="article-tags">
                {% for tag in tags %}
                    <span class="tag-chip">{{ tag }}</span>
                {% endfor %}
            </div>
        {% endif %}

        <h1 class="article-title">{{ title }}</h1>

        <div class="article-meta-bar">
            {% if date %}
                <span class="meta-item meta-date">
                    <svg class="meta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                    {{ date | brDate }}
                </span>
            {% endif %}

            <span class="meta-item meta-reading-time">
                <svg class="meta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {{ content | readingTime }}
            </span>
        </div>

        {% if description %}
            <p class="article-intro">{{ description }}</p>
        {% endif %}
    </header>

    <div class="article-content">
        {{ content | safe }}
    </div>

    <footer class="article-footer">
        <div class="article-share-cta">
            <p>Gostou ou tem dúvidas sobre este conteúdo? Conecte-se comigo no <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a> ou veja outros projetos no <a href="{{ site.github }}" target="_blank" rel="noopener">GitHub</a>.</p>
        </div>
        
        <div class="article-nav-back">
            {% if "/portfolio" in page.url %}
                <a href="/portfolio/" class="btn btn-secondary">← Ver todos os projetos</a>
            {% else %}
                <a href="/blog/" class="btn btn-secondary">← Ver todos os artigos</a>
            {% endif %}
        </div>
    </footer>
</article>
