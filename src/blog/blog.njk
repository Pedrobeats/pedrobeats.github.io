---
layout: "layouts/base.njk"
title: "Blog"
description: "Artigos, tutoriais práticos e reflexões sobre ciência de dados, tecnologia e desenvolvimento."
---

<div class="page-container">
    <header class="page-header">
        <h1 class="page-title">Blog</h1>
        <p class="page-intro">Artigos, tutoriais técnicos e reflexões sobre análise de dados, Python, automação e aprendizado contínuo.</p>
    </header>

    <div class="post-cards-grid">
        {%- for post in collections.blog -%}
        <article class="post-card">
            {%- if post.data.thumbnail -%}
            <a href="{{ post.url }}" class="post-card-thumb">
                <img src="{{ post.data.thumbnail }}" alt="Imagem do post {{ post.data.title }}" loading="lazy">
            </a>
            {%- endif -%}
            <div class="post-card-body">
                <div class="post-card-meta">
                    <span class="post-date">{{ post.data.date | brDate }}</span>
                    <span class="meta-dot">•</span>
                    <span class="post-read">{{ post.templateContent | readingTime }}</span>
                </div>

                <h2 class="post-card-title">
                    <a href="{{ post.url }}">{{ post.data.title }}</a>
                </h2>

                {% if post.data.description %}
                    <p class="post-card-excerpt">{{ post.data.description }}</p>
                {% endif %}

                {% if post.data.tags %}
                    <div class="post-card-tags">
                        {% for tag in post.data.tags %}
                            <span class="tag-chip tag-chip-sm">{{ tag }}</span>
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="post-card-footer">
                    <a href="{{ post.url }}" class="card-link">
                        Ler artigo completo
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>
        </article>
        {%- endfor -%}
    </div>
</div>
